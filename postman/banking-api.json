{
  "info": {
    "name": "NovaBank Mini Banking & Open Banking API",
    "_postman_id": "novabank-api-collection-v1",
    "description": "Comprehensive Postman collection for the Mini Banking & Open Banking Consent Management System. Includes authentication (Keycloak & JWT), Customers, Accounts, Transactions, Beneficiaries, and Consent lifecycle management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081", "type": "string" },
    { "key": "gatewayUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "customerId", "value": "1", "type": "string" },
    { "key": "accountId", "value": "1", "type": "string" },
    { "key": "transactionId", "value": "1", "type": "string" },
    { "key": "beneficiaryId", "value": "1", "type": "string" },
    { "key": "consentId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Admin (ADMIN role)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.access_token);",
                  "    pm.environment.set('authToken', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Authenticates as ADMIN. Automatically captures the Bearer token in collection variable."
          }
        },
        {
          "name": "Login as Maker (MAKER role)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"maker\",\n  \"password\": \"maker123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Authenticates as MAKER with transaction creation permissions."
          }
        },
        {
          "name": "Login as Checker (CHECKER role)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"checker\",\n  \"password\": \"checker123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Authenticates as CHECKER with consent approval/rejection permissions."
          }
        },
        {
          "name": "Keycloak Direct Token (OAuth2 Direct Grant)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "banking-client", "type": "text" },
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "username", "value": "admin", "type": "text" },
                { "key": "password", "value": "admin123", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/realms/banking-realm/protocol/openid-connect/token",
              "host": ["{{gatewayUrl}}"],
              "path": ["auth", "realms", "banking-realm", "protocol", "openid-connect", "token"]
            },
            "description": "Direct token acquisition from Keycloak OpenID Connect endpoint via Nginx Gateway."
          }
        }
      ]
    },
    {
      "name": "2. Customers",
      "item": [
        {
          "name": "List All Customers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"] }
          }
        },
        {
          "name": "Create Customer (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Santhosh Kumar\",\n  \"email\": \"santhosh.kumar@bank.com\",\n  \"phone\": \"+91 9876543210\",\n  \"address\": \"42 Tech Park Avenue, Bangalore\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"] }
          }
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api", "customers", "{{customerId}}"] }
          }
        },
        {
          "name": "Update Customer (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Santhosh Kumar Updated\",\n  \"email\": \"santhosh.updated@bank.com\",\n  \"phone\": \"+91 9876543219\",\n  \"address\": \"100 Brigade Road, Bangalore\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api", "customers", "{{customerId}}"] }
          }
        },
        {
          "name": "Delete Customer (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api", "customers", "{{customerId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Accounts",
      "item": [
        {
          "name": "List All Accounts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          }
        },
        {
          "name": "Create Account (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"accountNumber\": \"NOVA-1004521\",\n  \"accountType\": \"SAVINGS\",\n  \"initialBalance\": 50000.00,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/accounts", "host": ["{{baseUrl}}"], "path": ["api", "accounts"] }
          }
        },
        {
          "name": "Get Account by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}"] }
          }
        },
        {
          "name": "Update Account (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountType\": \"CURRENT\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/accounts/{{accountId}}", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "{{accountId}}"] }
          }
        },
        {
          "name": "Get Accounts by Customer",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/accounts/customer/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "customer", "{{customerId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Transactions",
      "item": [
        {
          "name": "Post Transaction (MAKER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1500.00,\n  \"type\": \"CREDIT\",\n  \"description\": \"Salary Deposit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Requires MAKER role. Supports CREDIT (increases balance) and DEBIT (decreases balance)."
          }
        },
        {
          "name": "Get Account Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{accountId}}", "transactions"]
            }
          }
        },
        {
          "name": "Get Transaction by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}"]
            }
          }
        },
        {
          "name": "List All Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/transactions", "host": ["{{baseUrl}}"], "path": ["api", "transactions"] }
          }
        }
      ]
    },
    {
      "name": "5. Beneficiaries",
      "item": [
        {
          "name": "List All Beneficiaries",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/beneficiaries", "host": ["{{baseUrl}}"], "path": ["api", "beneficiaries"] }
          }
        },
        {
          "name": "Create Beneficiary",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"name\": \"Priya Sharma\",\n  \"accountNumber\": \"501004512398\",\n  \"bankName\": \"HDFC Bank\",\n  \"ifscCode\": \"HDFC0001234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/beneficiaries", "host": ["{{baseUrl}}"], "path": ["api", "beneficiaries"] }
          }
        },
        {
          "name": "Get Beneficiary by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/beneficiaries/{{beneficiaryId}}", "host": ["{{baseUrl}}"], "path": ["api", "beneficiaries", "{{beneficiaryId}}"] }
          }
        },
        {
          "name": "Update Beneficiary",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya S Updated\",\n  \"accountNumber\": \"501004512398\",\n  \"bankName\": \"ICICI Bank\",\n  \"ifscCode\": \"ICIC0000999\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/beneficiaries/{{beneficiaryId}}", "host": ["{{baseUrl}}"], "path": ["api", "beneficiaries", "{{beneficiaryId}}"] }
          }
        },
        {
          "name": "Delete Beneficiary (ADMIN or CHECKER)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/beneficiaries/{{beneficiaryId}}", "host": ["{{baseUrl}}"], "path": ["api", "beneficiaries", "{{beneficiaryId}}"] },
            "description": "Requires ADMIN or CHECKER role."
          }
        }
      ]
    },
    {
      "name": "6. Consents",
      "item": [
        {
          "name": "List All Consents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/consents", "host": ["{{baseUrl}}"], "path": ["api", "consents"] }
          }
        },
        {
          "name": "Create Consent Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"purpose\": \"Open Banking Account Information Access\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/consents", "host": ["{{baseUrl}}"], "path": ["api", "consents"] }
          }
        },
        {
          "name": "Get Consent by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/consents/{{consentId}}", "host": ["{{baseUrl}}"], "path": ["api", "consents", "{{consentId}}"] }
          }
        },
        {
          "name": "Approve Consent (CHECKER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/consents/{{consentId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "consents", "{{consentId}}", "approve"]
            },
            "description": "Requires CHECKER role. Moves state from PENDING to APPROVED."
          }
        },
        {
          "name": "Reject Consent (CHECKER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/consents/{{consentId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "consents", "{{consentId}}", "reject"]
            },
            "description": "Requires CHECKER role. Moves state to REJECTED."
          }
        }
      ]
    },
    {
      "name": "7. System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Application Info",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/info", "host": ["{{baseUrl}}"], "path": ["api", "info"] }
          }
        }
      ]
    }
  ]
}
